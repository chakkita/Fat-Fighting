{
  "buildCommand": null,
  "outputDirectory": "public",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Referrer-Policy", "value": "same-origin" }
    ]},
    { "source": "/(index.html)?", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
